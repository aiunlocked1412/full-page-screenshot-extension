{
  "manifest_version": 3,
  "name": "Full Page Screenshot",
  "version": "1.0.0",
  "description": "ถ่ายภาพหน้าเว็บแบบเต็มหน้า โดยเลื่อนลงจนสุดแล้วต่อภาพให้อัตโนมัติ — ประกอบการศึกษาคอร์ส Claude Code โดย aiunlock.co",
  "homepage_url": "https://aiunlock.co",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ถ่ายภาพทั้งหน้า",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "ถ่ายภาพหน้าเว็บทั้งหน้า"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
